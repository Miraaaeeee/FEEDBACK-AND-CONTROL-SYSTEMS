      "id": "3609c1ff-9276-489a-bbd4-37771af79dfd",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.choices[0].message.content;\n\n// Remove markdown wrappers if AI adds them\nconst cleaned = raw\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// Parse AI JSON\nconst data = JSON.parse(cleaned);\n\n// Return structured fields\nreturn [\n  {\n    json: {\n\n      // Food Info\n      foodName: data.food_name || data.food || \"Unknown Food\",\n\n      calories: Number(data.calories) || 0,\n      protein: Number(data.protein) || 0,\n      carbs: Number(data.carbs) || 0,\n      fat: Number(data.fat) || 0,\n\n      // Health Score\n      healthScore:\n        Number(data.health_score) ||\n        Number(data.healthScore) ||\n        5,\n\n      // Advice\n      advice:\n        data.advice ||\n        \"Maintain balanced nutrition and portion control.\",\n\n      // Telegram User\n      user_id:\n        $node[\"Telegram Trigger\"].json[\"message\"][\"chat\"][\"id\"],\n\n      // Current Date\n      date:\n        new Date().toISOString().split(\"T\")[0]\n    }\n  }\n];"
      },
