        "chatId": "={{$node[\"Code in JavaScript\"].json[\"chat_id\"]}}",
        "text": "={{`🍽️ *AMI Nutrition Scanner*\n\n━━━━━━━━━━━━━━\n\n🍗 *Food:* ${$json.foodName}\n\n🔥 *Calories:* ${$json.calories} kcal\n🥩 *Protein:* ${$json.protein}g\n🍞 *Carbs:* ${$json.carbs}g\n🧈 *Fat:* ${$json.fat}g\n\n━━━━━━━━━━━━━━\n\n📊 *Daily Goal Progress*\n\n🔥 Calories Goal:\n${$json.calorieGoal} kcal\n\n🥩 Protein Goal:\n${$json.proteinGoal}g\n\n━━━━━━━━━━━━━━\n\n⚠️ *Remaining Today*\n\n🔥 Calories Left:\n${$json.remainingCalories} kcal\n\n🥩 Protein Left:\n${$json.remainingProtein}g\n\n━━━━━━━━━━━━━━\n\n🟡 *Health Score:* ${$json.healthScore}/10\n\n💬 ${$json.advice}\n\n━━━━━━━━━━━━━━\n\n🔥 Powered by *AMI AI*`}}",
