      "parameters": {
        "jsCode": "// ===============================\n// USER GOALS\n// ===============================\n\nconst calorieGoal = Number($node[\"Get row(s) in sheet\"].json[\"calorie_goal\"]);\n\nconst proteinGoal = Number($node[\"Get row(s) in sheet\"].json[\"protein_goal\"]);\n\n// ===============================\n// MEAL DATA\n// ===============================\n\nconst foodName = $node[\"Code in JavaScript1\"].json[\"foodName\"];\n\nconst calories = Number($node[\"Code in JavaScript1\"].json[\"calories\"]);\n\nconst protein = Number($node[\"Code in JavaScript1\"].json[\"protein\"]);\n\nconst carbs = Number($node[\"Code in JavaScript1\"].json[\"carbs\"]);\n\nconst fat = Number($node[\"Code in JavaScript1\"].json[\"fat\"]);\n\nconst healthScore = Number($node[\"Code in JavaScript1\"].json[\"healthScore\"]);\n\nconst advice = $node[\"Code in JavaScript1\"].json[\"advice\"];\n\n// ===============================\n// REMAINING DAILY GOALS\n// ===============================\n\nconst remainingCalories = calorieGoal - calories;\n\nconst remainingProtein = proteinGoal - protein;\n\n// ===============================\n// RETURN EVERYTHING\n// ===============================\n\nreturn [\n  {\n    json: {\n\n      foodName,\n\n      calories,\n      protein,\n      carbs,\n      fat,\n\n      healthScore,\n\n      advice,\n\n      calorieGoal,\n      proteinGoal,\n\n      remainingCalories,\n      remainingProtein\n    }\n  }\n];"
      },
