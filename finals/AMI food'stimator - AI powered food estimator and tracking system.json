        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"Analyze this food image.\\n\\nReturn ONLY valid JSON.\\n\\nFormat:\\n{\\n  \\\"food_name\\\": \\\"\\\",\\n  \\\"calories\\\": 0,\\n  \\\"protein\\\": 0,\\n  \\\"carbs\\\": 0,\\n  \\\"fat\\\": 0,\\n  \\\"health_score\\\": 0,\\n  \\\"advice\\\": \\\"\\\"\\n}\"\n        },\n        {\n          \"type\": \"image_url\",\n          \"image_url\": {\n            \"url\": \"data:image/jpeg;base64,{{$json.data}}\"\n          }\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1040,
        0
